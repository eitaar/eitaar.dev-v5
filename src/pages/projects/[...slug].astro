---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

const project = Astro.props;
const { title, summary, techStack, repoUrl, demoUrl, pubDate, category } = project.data;
const { Content } = await render(project);
const formattedDate = pubDate.toLocaleDateString("en-GB", {
	year: "numeric",
	month: "short",
	day: "2-digit",
});

const meta = [
	{ label: "Category", value: category },
	{ label: "Date", value: formattedDate },
	{ label: "Stack", value: techStack.join(" / ") },
];
---

<Layout title={`${title} / eitaar`} description={summary}>
	<article>
		<header
			class="art-section flex min-h-[100svh] flex-col justify-between px-5 pt-36 pb-8 md:px-8 md:pt-44 lg:px-12 lg:pt-48"
			data-art-state="4.4"
		>
			<div class="grid gap-8 lg:grid-cols-12">
				<a href="/projects" class="micro-label text-link w-fit lg:col-span-2" data-reveal>← archive</a>
				<p class="micro-label lg:col-span-3 lg:col-start-10 lg:text-right" data-reveal>{category} / {formattedDate}</p>
			</div>

			<div class="my-auto py-16">
				<h1
					class="display-type max-w-[92vw] text-[clamp(5rem,17vw,18rem)]"
					data-art-react
					data-art-state="4.85"
					data-art-energy="0.95"
					data-reveal
				>
					{title}
				</h1>
			</div>

			<div class="grid gap-8 border-t border-border/70 pt-6 lg:grid-cols-12">
				<p class="editorial-copy max-w-xl text-base md:text-lg lg:col-span-5" data-reveal>{summary}</p>
				<dl class="grid gap-5 sm:grid-cols-3 lg:col-span-6 lg:col-start-7" data-reveal>
					{meta.map((item) => (
						<div>
							<dt class="micro-label mb-2">{item.label}</dt>
							<dd class="text-sm leading-relaxed text-muted">{item.value}</dd>
						</div>
					))}
				</dl>
			</div>
		</header>

		<section
			class="art-section grid min-h-[85svh] content-center gap-14 px-5 py-28 md:px-8 md:py-36 lg:grid-cols-12 lg:px-12 lg:py-44"
			data-art-state="5.35"
		>
			<p class="micro-label lg:col-span-2" data-reveal>notes / context</p>
			<div
				class="editorial-copy project-prose max-w-3xl text-base leading-relaxed text-content md:text-lg lg:col-span-7 lg:col-start-4"
				data-reveal
			>
				<Content />
			</div>
		</section>

		<section class="border-t border-border/70 px-5 py-16 md:px-8 md:py-20 lg:px-12" data-art-state="5.9">
			<div class="grid gap-10 lg:grid-cols-12 lg:items-end">
				<p class="micro-label lg:col-span-2">links / exit</p>
				<div class="flex flex-col gap-3 lg:col-span-6 lg:col-start-4">
					{demoUrl && (
						<a href={demoUrl} target="_blank" rel="noopener noreferrer" class="display-type text-[clamp(3.8rem,8vw,8rem)] no-underline">
							visit ↗
						</a>
					)}
					{repoUrl && (
						<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="display-type text-[clamp(3.8rem,8vw,8rem)] no-underline">
							source ↗
						</a>
					)}
				</div>
			</div>
		</section>
	</article>
</Layout>

<style>
	.project-prose :global(h2),
	.project-prose :global(h3) {
		font-family: var(--font-display), Georgia, serif;
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.95;
		margin-top: 2.5em;
		margin-bottom: 0.65em;
	}

	.project-prose :global(h2) {
		font-size: clamp(2.8rem, 6vw, 5.8rem);
	}

	.project-prose :global(h3) {
		font-size: clamp(2rem, 4vw, 3.6rem);
	}

	.project-prose :global(p),
	.project-prose :global(ul),
	.project-prose :global(ol),
	.project-prose :global(pre),
	.project-prose :global(blockquote) {
		margin-top: 1.2em;
	}

	.project-prose :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.project-prose :global(code) {
		font-size: 0.88em;
	}

	.project-prose :global(pre) {
		overflow-x: auto;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding: 1.25rem 0;
	}
</style>
