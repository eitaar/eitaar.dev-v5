---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	const sorted = projects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return sorted.map((project, index) => ({
		params: { slug: project.id },
		props: { project, index },
	}));
}

const { project, index } = Astro.props;
const { title, summary, techStack, repoUrl, demoUrl, pubDate, category } = project.data;
const { Content } = await render(project);
const num = String(index + 1).padStart(2, "0");
const year = pubDate.getFullYear();
const formattedDate = pubDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});

const meta = [
	demoUrl && { label: "website", value: demoUrl.replace(/^https?:\/\//, ""), url: demoUrl },
	repoUrl && {
		label: "repository",
		value: new URL(repoUrl).pathname.slice(1),
		url: repoUrl,
	},
	{ label: "category", value: category },
	{ label: "date", value: formattedDate },
	{ label: "stack", value: techStack.join(" · ") },
].filter(Boolean) as { label: string; value: string; url?: string }[];
---

<Layout title={title} description={summary}>
	<article class="reveal px-gutter pt-32 pb-10 md:pt-44">
		<a href="/projects" class="label link-draw hover:text-ink">← back to the archive</a>
		<p class="label mt-16" style="--reveal-i: 0">
			entry {num} / {year}
		</p>
		<h1
			class="reveal-item mt-4 font-display text-[clamp(2.8rem,9vw,8rem)] leading-[0.95] font-light tracking-tight text-balance"
			style="--reveal-i: 1"
		>
			{title}
		</h1>
		<p
			class="reveal-item mt-8 max-w-[54ch] text-lg leading-relaxed text-muted md:text-xl"
			style="--reveal-i: 2"
		>
			{summary}
		</p>

		<hr class="hairline reveal-item mt-14" style="--reveal-i: 3" />

		<dl>
			{
				meta.map((item, i) => (
					<div
						class="reveal-item flex flex-wrap items-baseline justify-between gap-x-8 border-b border-line py-4"
						style={`--reveal-i: ${i + 4}`}
					>
						<dt class="label">{item.label}</dt>
						<dd class="max-w-[60ch] text-sm break-all md:text-base">
							{item.url ? (
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
									class="link-draw hover:text-accent"
								>
									{item.value} ↗
								</a>
							) : (
								item.value
							)}
						</dd>
					</div>
				))
			}
		</dl>

		{
			Content && (
				<div class="mt-14 max-w-[62ch] text-base leading-relaxed md:text-lg [&>*+*]:mt-5">
					<Content />
				</div>
			)
		}
	</article>
</Layout>
