---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="404 — eitaar"
	description="The page you are looking for does not exist."
	showFooter={false}
>
	<section
		class="art-section flex min-h-screen flex-col justify-between px-6 pt-32 pb-8 md:px-12 lg:px-20"
		data-art-state="7.2"
	>
		<div class="flex items-start justify-between gap-8">
			<p class="micro-label">Error / 404</p>
			<p class="micro-label text-right">Nothing here<br />except the surface.</p>
		</div>

		<div class="py-20">
			<p class="display-type text-[clamp(8rem,30vw,28rem)]">404</p>
			<p class="editorial-copy mt-8 max-w-md text-base text-muted md:ml-[42vw] md:text-lg">
				The page you were looking for has slipped out of the archive.
			</p>
		</div>

		<div class="flex items-end justify-between gap-6 border-t border-border pt-5">
			<a
				href="/"
				class="text-link font-display text-3xl leading-none italic md:text-5xl"
				data-art-react
				data-art-state="0"
				data-art-energy="0.8"
			>
				return home
			</a>
			<span class="micro-label">eitaar.dev</span>
		</div>
	</section>
</Layout>
