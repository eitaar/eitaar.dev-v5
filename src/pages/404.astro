---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="404 — not found"
	description="The page you are looking for does not exist."
	showHeader={false}
	showFooter={false}
>
	<section class="flex min-h-svh flex-col justify-between px-gutter py-10">
		<p class="label">eitaar.dev — a page out of the index</p>
		<div>
			<h1
				aria-label="404, page not found"
				class="font-display leading-[0.85] font-light tracking-tight select-none"
			>
				<span aria-hidden="true" class="block text-[clamp(6rem,28vw,20rem)]">
					4<span class="hollow">0</span>4
				</span>
			</h1>
			<p class="mt-8 max-w-[38ch] text-muted">
				This page isn't in the archive. It may have been moved, renamed, or never printed.
			</p>
			<a href="/" class="link-draw mt-10 inline-block text-lg hover:text-accent">
				← back to the index
			</a>
		</div>
		<p class="label">error 404 · not found</p>
	</section>
</Layout>
