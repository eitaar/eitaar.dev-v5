---
import { Image } from "astro:assets";
import avatarImg from "../assets/img/avatar.png";
import Layout from "../layouts/Layout.astro";
---

<Layout title="eitaar.dev" description="Eitaar's personal website">
	<div class="flex min-h-screen w-full items-center justify-center gap-32 p-16">
		<div class="flex flex-col items-start justify-center gap-7 pt-10">
			<h1 class="font-ndot47 text-8xl tracking-tight">eitaar</h1>
			<h2 class="font-share text-2xl tracking-tight text-muted">Software Developer / Student</h2>
		</div>
		<Image
			class="h-96 w-96"
			src={avatarImg}
			alt="avatar image"
			fetchpriority={"high"}
			loading={"eager"}
			format="avif"
		/>
	</div>
</Layout>
