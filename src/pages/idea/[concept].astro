---
import { getCollection } from "astro:content";
import Alive from "../../components/atmosphere/Alive.astro";
import InkGlass from "../../components/atmosphere/InkGlass.astro";
import LivingPaper from "../../components/atmosphere/LivingPaper.astro";
import QuietSpace from "../../components/atmosphere/QuietSpace.astro";
import Specimen from "../../components/atmosphere/Specimen.astro";
import IdeaIndexContent from "../../components/IdeaIndexContent.astro";
import Layout from "../../layouts/Layout.astro";

const concepts = {
	alive: {
		label: "Alive",
		description: "The existing index, made subtly alive.",
		component: Alive,
	},
	"living-paper": {
		label: "Living Paper",
		description: "A quiet paper-and-ink atmosphere around the existing index.",
		component: LivingPaper,
	},
	"ink-glass": {
		label: "Ink Glass",
		description: "A soft translucent ink presence behind the existing index.",
		component: InkGlass,
	},
	specimen: {
		label: "Specimen",
		description: "The existing index treated like a restrained technical specimen.",
		component: Specimen,
	},
	"quiet-space": {
		label: "Quiet Space",
		description: "The existing index placed inside a subtle sense of depth and space.",
		component: QuietSpace,
	},
} as const;

export function getStaticPaths() {
	return Object.keys(concepts).map((concept) => ({ params: { concept } }));
}

const concept = Astro.params.concept as keyof typeof concepts;
const selected = concepts[concept];
const Atmosphere = selected.component;

const projects = await getCollection("projects");
const topProjects = projects
	.filter((project) => project.data.topProject)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
	title={`eitaar — ${selected.label}`}
	description={`${selected.description} Experimental atmosphere study for eitaar.dev.`}
>
	<Atmosphere />
	<IdeaIndexContent topProjects={topProjects} concept={concept} />
</Layout>
