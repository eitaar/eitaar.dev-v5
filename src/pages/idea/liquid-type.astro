---
import { getCollection } from "astro:content";
import LiquidTypeField from "../../components/LiquidTypeField.astro";
import { contacts } from "../../data/contacts";
import { skillGroups } from "../../data/skills";
import Layout from "../../layouts/Layout.astro";

const projects = await getCollection("projects");
const topProjects = projects
	.filter((project) => project.data.topProject)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const email = contacts.find((contact) => contact.label === "Email");
const socialContacts = contacts.filter((contact) => contact.label !== "Email");
---

<Layout
	title="eitaar — liquid type study"
	description="An alternate liquid typography study for eitaar.dev"
	showHeader={false}
	showFooter={false}
	showArtwork={false}
>
	<LiquidTypeField />

	<div class="liquid-page relative z-10">
		<nav class="liquid-nav" aria-label="Idea navigation">
			<a href="/" class="text-link">eitaar</a>
			<span>idea / liquid type</span>
			<a href="/idea/calligraphic-ink" class="text-link">calligraphic ink ↗</a>
			<button id="theme-toggle" type="button" class="text-link cursor-pointer">invert</button>
		</nav>

		<section class="liquid-hero min-h-[100svh] px-5 pt-24 pb-8 md:px-8 lg:px-12" data-reveal>
			<div class="flex justify-between gap-6">
				<p class="micro-label">01 / introduction</p>
				<p class="micro-label max-w-48 text-right">student / developer<br />ideas → working things</p>
			</div>

			<div class="liquid-hero-word" aria-label="eitaar">
				<span class="liquid-shadow" aria-hidden="true">eitaar</span>
				<h1 class="liquid-type-strong">eitaar</h1>
			</div>

			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-12 lg:items-end">
				<p class="editorial-copy max-w-sm text-sm text-muted lg:col-span-4">
					A personal archive of software, experiments, half-finished thoughts, and the occasional thing that survives contact with reality.
				</p>
				<p class="micro-label sm:text-right lg:col-span-2 lg:col-start-11">move / scroll<br />let the letters slip</p>
			</div>
		</section>

		<section class="liquid-about min-h-[120svh] px-5 py-32 md:px-8 lg:px-12" data-reveal>
			<div class="grid gap-12 lg:grid-cols-12">
				<p class="micro-label lg:col-span-2">02 / about</p>
				<div class="lg:col-span-9 lg:col-start-4">
					<p class="liquid-statement liquid-type-soft">I follow a thought until it becomes something I can run.</p>
				</div>
			</div>

			<div class="mt-28 grid gap-10 lg:grid-cols-12">
				<p class="editorial-copy max-w-xl text-lg text-muted lg:col-span-5 lg:col-start-2">
					I'm a student in the UK. I play with little projects that link separate things, mostly to find out whether they hold up once they're running. A lot of it is just me following a thought and seeing where it lands.
				</p>
				<p class="editorial-copy max-w-sm text-lg text-muted lg:col-span-3 lg:col-start-9 lg:mt-44">
					Off the keyboard, I tend to disappear into books and comics, or just listen to music.
				</p>
			</div>
		</section>

		<section class="liquid-skills min-h-screen px-5 py-32 md:px-8 lg:px-12" data-reveal>
			<div class="mb-20 flex items-end justify-between gap-8">
				<p class="micro-label">03 / working vocabulary</p>
				<h2 class="liquid-section-title liquid-type-soft text-right">use / learn</h2>
			</div>

			<div class="liquid-skill-list border-t border-border/70">
				{
					skillGroups.map((group, groupIndex) => (
						<div class="liquid-skill-row border-b border-border/70 py-6 md:py-8">
							<div class="mb-5 flex justify-between gap-5">
								<p class="micro-label">{String(groupIndex + 1).padStart(2, "0")}</p>
								<p class="micro-label max-w-60 text-right">{group.category}</p>
							</div>
							<p class="liquid-skill-words liquid-type-soft">
								{group.items.map((item, index) => (
									<><span>{item}</span>{index < group.items.length - 1 && <span class="liquid-slash"> / </span>}</>
								))}
							</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="liquid-projects px-5 py-32 md:px-8 lg:px-12" data-reveal>
			<div class="mb-24 grid gap-8 lg:grid-cols-12 lg:items-end">
				<p class="micro-label lg:col-span-2">04 / selected work</p>
				<h2 class="liquid-section-title liquid-type-strong lg:col-span-8 lg:col-start-4">Projects</h2>
			</div>

			<div class="border-t border-border/70">
				{
					topProjects.map((project, index) => {
						const year = project.data.pubDate.getFullYear();
						return (
							<a href={`/projects/${project.id}`} class="liquid-project group block border-b border-border/70 py-8 no-underline md:py-12">
								<div class="mb-5 flex items-baseline justify-between gap-6">
									<p class="micro-label">{String(index + 1).padStart(2, "0")} / {year}</p>
									<p class="micro-label text-right">{project.data.techStack.join(" · ")}</p>
								</div>
								<h3 class="liquid-project-title liquid-type-soft">{project.data.title}</h3>
								<p class="editorial-copy mt-6 max-w-xl text-sm text-muted md:text-base">{project.data.summary}</p>
							</a>
						);
					})
				}
			</div>
		</section>

		<section class="liquid-contact flex min-h-[105svh] flex-col justify-between px-5 pt-32 pb-10 md:px-8 lg:px-12" data-reveal>
			<div class="grid gap-8 lg:grid-cols-12">
				<p class="micro-label lg:col-span-2">05 / elsewhere</p>
				<p class="editorial-copy max-w-md text-muted lg:col-span-4 lg:col-start-8">
					If something here makes you want to talk, build, question, or send an interesting link, the line is open.
				</p>
			</div>

			{
				email && (
					<a href={email.link} class="liquid-email liquid-type-strong my-auto block break-all no-underline">
						{email.name}
					</a>
				)
			}

			<div class="grid gap-7 border-t border-border/70 pt-7 sm:grid-cols-2 lg:grid-cols-4">
				{
					socialContacts.map((contact) => (
						<a href={contact.link} class="no-underline" target="_blank" rel="noopener noreferrer">
							<p class="micro-label mb-2">{contact.label}</p>
							<p class="font-display text-3xl tracking-[-0.04em]">{contact.name}</p>
						</a>
					))
				}
			</div>
		</section>
	</div>
</Layout>

<style>
	.liquid-page {
		overflow: clip;
	}

	.liquid-nav {
		position: fixed;
		top: 1rem;
		left: 1.25rem;
		right: 1.25rem;
		z-index: 40;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.35rem 1rem;
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		mix-blend-mode: difference;
	}

	.liquid-nav span,
	.liquid-nav a:nth-of-type(2) {
		display: none;
	}

	.liquid-hero-word {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 62svh;
		margin-left: -0.07em;
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(7.2rem, 27vw, 26rem);
		font-weight: 500;
		line-height: 0.72;
		letter-spacing: -0.075em;
		white-space: nowrap;
	}

	.liquid-hero-word h1 {
		position: relative;
		z-index: 2;
		font: inherit;
	}

	.liquid-shadow {
		position: absolute;
		left: 0.03em;
		top: 50%;
		z-index: 1;
		transform: translateY(-49%);
		color: transparent;
		-webkit-text-stroke: 1px color-mix(in srgb, var(--content) 25%, transparent);
		opacity: 0.62;
	}

	.liquid-statement {
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(4rem, 11vw, 11.5rem);
		font-weight: 400;
		line-height: 0.82;
		letter-spacing: -0.06em;
	}

	.liquid-section-title {
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(5rem, 14vw, 14rem);
		font-weight: 400;
		line-height: 0.74;
		letter-spacing: -0.07em;
	}

	.liquid-skill-words {
		max-width: 100%;
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(2.9rem, 7.1vw, 7.2rem);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.055em;
	}

	.liquid-slash {
		color: var(--muted);
		font-style: italic;
		font-weight: 400;
	}

	.liquid-project-title {
		max-width: 94vw;
		transform-origin: left center;
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(4.4rem, 13vw, 13rem);
		font-weight: 400;
		line-height: 0.78;
		letter-spacing: -0.07em;
		transition: letter-spacing 600ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.liquid-project:hover .liquid-project-title,
	.liquid-project:focus-visible .liquid-project-title {
		letter-spacing: -0.095em;
		filter: url(#liquid-type-strong);
	}

	.liquid-email {
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(3.5rem, 12vw, 12rem);
		font-weight: 400;
		line-height: 0.8;
		letter-spacing: -0.065em;
	}

	@media (min-width: 768px) {
		.liquid-nav {
			left: 2rem;
			right: 2rem;
			grid-template-columns: 1fr 1fr 1fr auto;
		}

		.liquid-nav span,
		.liquid-nav a:nth-of-type(2) {
			display: block;
		}

		.liquid-nav a:nth-of-type(2) {
			justify-self: end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.liquid-project-title {
			transition: none;
		}
	}
</style>
