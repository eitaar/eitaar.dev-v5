---
const NAV_LINKS = [
	{ text: "Projects", url: "/projects" },
	{ text: "Posts", url: "/posts" },
	// { text: "Contact", url: "#contact" },
];

import { Icon } from "astro-icon/components";
---

<header
	class="fixed top-0 right-0 left-0 z-50 flex h-20 items-center justify-end px-6 py-4 lg:justify-between"
>
	<a class="hidden font-ndot47 text-lg lg:block" href="/">eitaar</a>
	<nav>
		<ul class="flex gap-3 font-share text-lg text-muted sm:gap-4">
			{
				NAV_LINKS.map((link) => (
					<li>
						<a href={link.url} class="hidden lg:block">
							{link.text}
						</a>
					</li>
				))
			}
			<li>
				<button id="theme-toggle" class="" aria-label="toggle dark mode">
					<Icon name="bi:moon-stars-fill" class="hidden h-5 w-5 dark:block" />
					<Icon name="bi:sun-fill" class="h-5 w-5 dark:hidden" />
				</button>
			</li>
		</ul>
	</nav>
</header>
