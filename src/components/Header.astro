---
import Pill from "./ui/Pill.astro";

const NAV_LINKS = [
	{ text: "About", url: "#about" },
	{ text: "Works", url: "#works" },
	{ text: "Skills", url: "#skills" },
	{ text: "Contact", url: "#contact" },
];
---

<header
	id="site-header"
	class="fixed top-0 h-20 right-0 left-0 z-50 flex items-center justify-between px-8 py-4 transition-[background-color,border-color] duration-300"
>
	<a href="/" class="font-heading text-2xl leading-none font-bold text-text no-underline">
		te<span class="text-purple">x</span>t
	</a>

	<Pill links={NAV_LINKS} hasThemeSwitcher />
</header>
