<canvas id="calligraphic-ink" aria-hidden="true"></canvas>

<script>
	const canvas = document.querySelector<HTMLCanvasElement>("#calligraphic-ink");
	const ctx = canvas?.getContext("2d");

	if (canvas && ctx) {
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let width = 1;
		let height = 1;
		let dpr = 1;
		let scrollTarget = 0;
		let scrollValue = 0;
		let pointerX = 0.5;
		let pointerY = 0.5;
		let pointerTargetX = 0.5;
		let pointerTargetY = 0.5;
		let ink = "#11100e";
		let muted = "#716d64";
		let raf = 0;

		function cssColor(name: string, fallback: string) {
			const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
			return value || fallback;
		}

		function syncTheme() {
			ink = cssColor("--ink", "#11100e");
			muted = cssColor("--muted", "#716d64");
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, window.innerWidth < 720 ? 1.15 : 1.5);
			width = Math.max(1, window.innerWidth);
			height = Math.max(1, window.innerHeight);
			canvas.width = Math.floor(width * dpr);
			canvas.height = Math.floor(height * dpr);
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		}

		function scrollProgress() {
			const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
			return Math.min(1, Math.max(0, window.scrollY / max));
		}

		function cubic(
			a: [number, number],
			b: [number, number],
			c: [number, number],
			d: [number, number],
			t: number,
		) {
			const mt = 1 - t;
			const mt2 = mt * mt;
			const t2 = t * t;
			return [
				mt2 * mt * a[0] + 3 * mt2 * t * b[0] + 3 * mt * t2 * c[0] + t2 * t * d[0],
				mt2 * mt * a[1] + 3 * mt2 * t * b[1] + 3 * mt * t2 * c[1] + t2 * t * d[1],
			] as [number, number];
		}

		function drawSegmentedStroke(
			points: [number, number][],
			progress: number,
			baseWidth: number,
			color: string,
			opacity: number,
			phase: number,
		) {
			const visible = Math.max(2, Math.floor(points.length * Math.min(1, Math.max(0, progress))));
			ctx.save();
			ctx.lineCap = "round";
			ctx.lineJoin = "round";
			ctx.strokeStyle = color;
			ctx.globalAlpha = opacity;

			for (let i = 1; i < visible; i++) {
				const a = points[i - 1];
				const b = points[i];
				const p = i / Math.max(1, points.length - 1);
				const taper = Math.sin(Math.PI * Math.min(1, p * 1.08));
				const pulse = 0.72 + 0.28 * Math.sin(p * 19 + phase);
				ctx.lineWidth = Math.max(0.5, baseWidth * taper * pulse);
				ctx.beginPath();
				ctx.moveTo(a[0], a[1]);
				ctx.lineTo(b[0], b[1]);
				ctx.stroke();
			}
			ctx.restore();
		}

		function makeCurve(
			control: [[number, number], [number, number], [number, number], [number, number]],
			count = 180,
		) {
			const [a, b, c, d] = control;
			return Array.from({ length: count }, (_, i) => cubic(a, b, c, d, i / (count - 1)));
		}

		function drawBleed(x: number, y: number, radius: number, alpha: number) {
			ctx.save();
			ctx.fillStyle = ink;
			ctx.globalAlpha = alpha;
			for (let ring = 0; ring < 7; ring++) {
				const r = radius * (0.45 + ring * 0.13);
				ctx.beginPath();
				ctx.arc(x + Math.sin(ring * 2.4) * radius * 0.08, y + Math.cos(ring * 1.7) * radius * 0.07, r, 0, Math.PI * 2);
				ctx.fill();
				ctx.globalAlpha *= 0.62;
			}
			ctx.restore();
		}

		function draw(now: number) {
			ctx.clearRect(0, 0, width, height);
			const t = reducedMotion.matches ? 1.7 : now * 0.001;
			const scroll = reducedMotion.matches ? scrollTarget : scrollValue;
			const driftX = (pointerX - 0.5) * Math.min(55, width * 0.04);
			const driftY = (pointerY - 0.5) * Math.min(40, height * 0.035);
			const minSide = Math.min(width, height);

			const sweep = makeCurve([
				[-0.12 * width, 0.77 * height + driftY],
				[0.18 * width + driftX, 0.08 * height],
				[0.73 * width - driftX, 1.08 * height],
				[1.12 * width, 0.21 * height - driftY],
			]);

			const hook = makeCurve([
				[0.78 * width, -0.08 * height],
				[0.44 * width, 0.22 * height + driftY],
				[1.08 * width, 0.56 * height - driftY],
				[0.62 * width + driftX, 1.12 * height],
			], 150);

			const whisper = makeCurve([
				[-0.06 * width, 0.26 * height],
				[0.22 * width, 0.42 * height - driftY],
				[0.39 * width + driftX, 0.18 * height],
				[0.58 * width, 0.34 * height],
			], 110);

			const mainProgress = Math.min(1, scroll * 1.42 + 0.08);
			const hookProgress = Math.min(1, Math.max(0, scroll * 1.65 - 0.32));
			const whisperProgress = Math.min(1, Math.max(0, scroll * 2.2 - 0.05));

			// Soft absorbed edge first, then the wet core.
			drawSegmentedStroke(sweep, mainProgress, minSide * 0.052, ink, 0.065, t * 0.55);
			drawSegmentedStroke(sweep, mainProgress, minSide * 0.022, ink, 0.72, t * 0.8);
			drawSegmentedStroke(hook, hookProgress, minSide * 0.036, ink, 0.045, 2.1 + t * 0.42);
			drawSegmentedStroke(hook, hookProgress, minSide * 0.014, ink, 0.56, 1.3 + t * 0.62);
			drawSegmentedStroke(whisper, whisperProgress, minSide * 0.009, muted, 0.34, 4.0 + t * 0.35);

			if (scroll > 0.18) drawBleed(width * 0.31 + driftX * 0.4, height * 0.49, minSide * 0.025, Math.min(0.12, (scroll - 0.18) * 0.28));
			if (scroll > 0.52) drawBleed(width * 0.72 - driftX * 0.2, height * 0.66, minSide * 0.018, Math.min(0.09, (scroll - 0.52) * 0.25));
		}

		function frame(now: number) {
			scrollValue += (scrollTarget - scrollValue) * 0.055;
			pointerX += (pointerTargetX - pointerX) * 0.04;
			pointerY += (pointerTargetY - pointerY) * 0.04;
			draw(now);
			raf = requestAnimationFrame(frame);
		}

		function updateScroll() {
			scrollTarget = scrollProgress();
			if (reducedMotion.matches) draw(performance.now());
		}

		function updatePointer(event: PointerEvent) {
			pointerTargetX = event.clientX / Math.max(1, width);
			pointerTargetY = event.clientY / Math.max(1, height);
		}

		const themeObserver = new MutationObserver(() => {
			syncTheme();
			if (reducedMotion.matches) draw(performance.now());
		});
		themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

		window.addEventListener("resize", () => {
			resize();
			draw(performance.now());
		}, { passive: true });
		window.addEventListener("scroll", updateScroll, { passive: true });
		if (window.matchMedia("(pointer: fine)").matches && !reducedMotion.matches) {
			window.addEventListener("pointermove", updatePointer, { passive: true });
		}

		resize();
		syncTheme();
		updateScroll();
		draw(performance.now());
		if (!reducedMotion.matches) raf = requestAnimationFrame(frame);

		window.addEventListener("pagehide", () => cancelAnimationFrame(raf), { once: true });
	}
</script>

<style>
	#calligraphic-ink {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		mix-blend-mode: multiply;
	}

	:global([data-theme="dark"]) #calligraphic-ink {
		mix-blend-mode: screen;
		opacity: 0.86;
	}
</style>
