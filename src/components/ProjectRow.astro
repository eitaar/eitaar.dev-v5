---
import type { CollectionEntry } from "astro:content";

interface Props {
	project: CollectionEntry<"projects">;
	index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, summary, techStack, pubDate, category } = project.data;
const year = pubDate.getFullYear();
const num = String(index + 1).padStart(2, "0");
const href = `/projects/${project.id}`;
---

<article
	class="reveal-item border-t border-line md:even:ml-[8%]"
	style={`--reveal-i: ${index % 6}`}
>
	<a
		href={href}
		class="group grid grid-cols-[auto_1fr] gap-x-5 gap-y-3 py-10 md:gap-x-10 md:py-14"
		data-artwork-pulse
	>
		<span class="label pt-3 transition-colors duration-500 group-hover:text-accent">{num}</span>
		<div class="min-w-0">
			<div class="flex flex-wrap items-baseline justify-between gap-x-8">
				<h3
					class="font-display text-[clamp(1.9rem,5.5vw,4.25rem)] leading-[1.02] font-light tracking-tight text-balance transition-transform duration-700 ease-viscous group-hover:translate-x-3"
				>
					{title}
				</h3>
				<span class="label shrink-0">{year}</span>
			</div>
			<p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-muted md:text-base">
				{summary}
			</p>
			<p class="label mt-4 tracking-[0.08em] normal-case">
				{category}
				<span aria-hidden="true">·</span>
				{techStack.join(" · ")}
			</p>
		</div>
	</a>
</article>

<script>
	{
		for (const el of document.querySelectorAll<HTMLElement>("[data-artwork-pulse]")) {
			const fire = () => {
				const r = el.getBoundingClientRect();
				window.dispatchEvent(
					new CustomEvent("eitaar:pulse", {
						detail: { x: r.left + r.width / 2, y: r.top + r.height / 2 },
					}),
				);
			};
			el.addEventListener("pointerenter", fire);
			el.addEventListener("focus", fire, true);
		}
	}
</script>
