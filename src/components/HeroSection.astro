---

---

<section
	id="hero"
	class="relative flex min-h-screen flex-col justify-center overflow-hidden bg-bg px-12"
>
	<!-- Decorative blobs -->
	<div aria-hidden="true" class="pointer-events-none">
		<div
			class="bg-c1-pale border-c1 absolute top-[8%] left-[72%] h-20 w-20 animate-float-a rounded-full border-[3px]"
		>
		</div>
		<div
			class="bg-c3-pale border-c3 absolute top-[20%] left-[88%] h-12.5 w-12.5 animate-float-b rounded-full border-[3px]"
		>
		</div>
		<div
			class="bg-c2-pale border-c2 absolute top-[55%] left-[80%] h-30 w-30 animate-float-a rounded-full border-[3px] [animation-delay:1s]"
		>
		</div>
		<div
			class="bg-c4-pale border-c4 absolute top-[70%] left-[90%] h-9 w-9 animate-float-b rounded-full border-[3px] [animation-delay:.5s]"
		>
		</div>
		<span class="text-c3 absolute top-[12%] left-[60%] animate-spin-slow text-[22px]">★</span>
		<span
			class="text-c4 absolute top-[40%] left-[75%] animate-spin-slow text-[14px] [animation-direction:reverse]"
			>✦</span
		>
		<span class="text-c1 absolute top-[65%] left-[66%] animate-spin-slow text-[11px]">◆</span>
	</div>
	<h1 class="font-heading text-[12rem] font-bold tracking-tight">eitaar</h1>
	<!-- Bottom: description + stickers -->
	<div class="flex flex-wrap items-end justify-between gap-6">
		<p class="hero-fade max-w-sm font-body text-base leading-relaxed font-light text-muted">
			<strong class="font-medium text-text">デザインとコードのあいだ</strong>に立って、<br />
			使いやすくて、ちょっと<strong class="font-medium text-text">好きになれる</strong>ものを<br />
			つくっています。
		</p>

		<div class="hero-fade flex flex-wrap gap-3">
			<div
				class="bg-c2-pale inline-flex animate-badge-float cursor-default items-center gap-2 rounded-[20px] border-[3px] border-border px-5 py-3 font-heading text-sm font-semibold text-text shadow-(--shadow) transition-all duration-200 hover:-translate-y-1 hover:-rotate-2 hover:shadow-(--shadow-h)"
			>
				<span class="bg-c2 h-2.5 w-2.5 animate-pulse rounded-full"></span>
				Available
			</div>
			<a
				href="#works"
				class="bg-c3-pale rounded-[20px] border-[3px] border-border px-5 py-3 font-heading text-sm font-semibold text-text no-underline shadow-(--shadow) transition-all duration-200 hover:-translate-y-1 hover:-rotate-2 hover:shadow-(--shadow-h)"
			>
				Works ↓
			</a>
			<a
				href="#contact"
				class="bg-c1-pale rounded-[20px] border-[3px] border-border px-5 py-3 font-heading text-sm font-semibold text-text no-underline shadow-(--shadow) transition-all duration-200 hover:-translate-y-1 hover:-rotate-2 hover:shadow-(--shadow-h)"
			>
				Contact ↓
			</a>
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";

	function initHero() {
		// Letter bounce-in
		gsap.fromTo(
			".hero-letter",
			{ autoAlpha: 0, y: 50, scale: 0.7 },
			{
				autoAlpha: 1,
				y: 0,
				scale: 1,
				duration: 0.6,
				ease: "back.out(1.7)",
				stagger: 0.07,
			},
		);

		// Eyebrow + description + stickers fade up after letters
		gsap.fromTo(
			".hero-fade",
			{ autoAlpha: 0, y: 20 },
			{
				autoAlpha: 1,
				y: 0,
				duration: 0.5,
				ease: "power2.out",
				stagger: 0.12,
				delay: 0.55,
			},
		);
	}

	document.addEventListener("astro:page-load", initHero);
</script>
